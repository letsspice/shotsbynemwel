# Public site URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://shotsbynemwel.netlify.app

# Admin ("Studio") hidden URL. In development, without this, the admin is at /manage.
# In production the admin is DISABLED unless this is set; it is then only reachable at /<ADMIN_SLUG>.
# Use something long and unguessable, e.g. studio-7f3k9q2m.
ADMIN_SLUG=

# Upstash Redis (REST). When both are set, all content reads/writes go to Upstash instead of content/*.json.
# Empty keys fall back to the seed files, so the site never renders empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional key prefix (default: sbn:content)
CONTENT_KEY_PREFIX=
